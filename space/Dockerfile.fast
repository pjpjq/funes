FROM python:3.12-slim-bookworm
WORKDIR /app
COPY service /app/service
COPY server.py /app/server.py
COPY README.md /app/README.md
RUN pip install --no-cache-dir 'huggingface_hub>=1.16,<2'
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh \
        | sh -s -- -b /usr/local/bin v3.95.5 \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 PORT=7860 \
    FUNES_DATA_DIR=/tmp/funes-data \
    FUNES_REQUIRE_DURABLE_ACK=true \
    FUNES_ALLOW_EMPTY_REMOTE=false \
    FUNES_LAZY_RESTORE=true \
    FUNES_RESTORE_BATCH=5000
RUN mkdir -p /tmp/funes-data
EXPOSE 7860
CMD ["python", "/app/server.py"]
